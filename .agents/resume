#!/usr/bin/env bash

set -euo pipefail

orb_environment="$HOME/.config/luv/orb-env.sh"
if [[ ! -r "$orb_environment" ]]; then
  printf 'luv orb environment is missing; run .agents/setup\n' >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$orb_environment"

if ! command -v nix >/dev/null 2>&1; then
  printf 'luv orb environment did not provide Nix.\n' >&2
  exit 1
fi

"$LUV_PROJECT_ROOT/env" --slim sh -c '
  test "$LUV_DEV_ENVIRONMENT_MODE" = nix-develop
  command -v sbcl >/dev/null
'
printf 'luv orb environment ready.\n'
