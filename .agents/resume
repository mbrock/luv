#!/usr/bin/env bash

set -euo pipefail

orb_environment="$HOME/.config/luv/orb-env.sh"
if [[ ! -r "$orb_environment" ]]; then
  printf 'luv orb environment is missing; run .agents/setup\n' >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$orb_environment"

if [[ ${LUV_SLY_SYSTEM:-} != luft ]]; then
  printf 'luv orb environment is not using the slim LUFT profile; run .agents/setup\n' >&2
  exit 1
fi

case "$(command -v sbcl 2>/dev/null)" in
  "$HOME/.nix-profile/"*|/nix/store/*)
    case ":${CL_SOURCE_REGISTRY:-}:" in
      *:"$LUV_PROJECT_ROOT/":*) printf 'luv orb environment ready.\n' ;;
      *) printf 'luv checkout is missing from ASDF discovery.\n' >&2; exit 1 ;;
    esac
    ;;
  *)
    printf 'luv development profile did not provide SBCL.\n' >&2
    exit 1
    ;;
esac
