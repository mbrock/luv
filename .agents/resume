#!/usr/bin/env bash

set -euo pipefail

profile_environment="$HOME/.nix-profile/share/luv/env.sh"
if [[ ! -r "$profile_environment" ]]; then
  printf 'luv development profile is missing; run .agents/setup\n' >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$profile_environment"

case "$(command -v sbcl 2>/dev/null)" in
  "$HOME/.nix-profile/"*|/nix/store/*)
    printf 'luv development profile ready.\n'
    ;;
  *)
    printf 'luv development profile did not provide SBCL.\n' >&2
    exit 1
    ;;
esac
