#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label=$1
  shift
  printf '\n==> %s\n' "$label"
  local started=$SECONDS
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

install_system_packages() {
  local package
  local -a missing=()
  for package in ca-certificates curl git xz-utils; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null \
      | grep -Fqx 'install ok installed' || missing+=("$package")
  done

  if ((${#missing[@]})); then
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  else
    printf 'Required system packages are already installed.\n'
  fi
}

install_nix() {
  if ! command -v nix >/dev/null 2>&1 \
    && [[ -x /nix/var/nix/profiles/default/bin/nix ]]; then
    # A stale snapshot can retain Nix without retaining its parent process's PATH.
    export PATH="/nix/var/nix/profiles/default/bin:$PATH"
  fi

  if command -v nix >/dev/null 2>&1; then
    nix --version
    return
  fi

  local installer
  installer=$(mktemp)
  trap "rm -f '$installer'" EXIT
  curl --fail --location --show-error --progress-bar \
    https://install.determinate.systems/nix >"$installer"
  sh "$installer" install --no-confirm
  rm -f "$installer"
  trap - EXIT
}

activate_nix() {
  local profile
  for profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    if [[ -r "$profile" ]]; then
      # shellcheck disable=SC1090
      source "$profile"
      return
    fi
  done

  printf 'Nix was installed but no profile activation script was found.\n' >&2
  return 1
}

install_shell_environment() {
  local environment_dir="$HOME/.config/luv"
  local environment="$environment_dir/orb-env.sh"
  local marker='# luv orb development profile v2'

  mkdir -p "$environment_dir"
  {
    cat <<'EOF'
# Generated by the luv orb setup. Sourced by login shells and through BASH_ENV.
EOF
    printf 'export LUV_PROJECT_ROOT=%q\n' "$repo_root"
    cat <<'EOF'
case ":$PATH:" in
  *:/nix/var/nix/profiles/default/bin:*) ;;
  *) export PATH="/nix/var/nix/profiles/default/bin:$PATH" ;;
esac

profile_environment="$HOME/.nix-profile/share/luv/env.sh"
if [[ ! -r "$profile_environment" ]]; then
  printf 'luv development profile is missing; run .agents/setup\n' >&2
  return 1
fi
# shellcheck disable=SC1090
source "$profile_environment"

# The Nix profile owns dependencies; this mutable path owns the checkout's
# root system definitions. Keep repeated BASH_ENV activation idempotent.
case ":${CL_SOURCE_REGISTRY:-}:" in
  *:"$LUV_PROJECT_ROOT/":*) ;;
  *) export CL_SOURCE_REGISTRY="$LUV_PROJECT_ROOT/:${CL_SOURCE_REGISTRY:-}" ;;
esac
EOF
  } >"$environment"
  chmod 600 "$environment"

  touch "$HOME/.bash_profile"
  if grep -Fqx "$marker" "$HOME/.bash_profile"; then
    printf 'Orb shell environment is already installed.\n'
    return
  fi

  cat >>"$HOME/.bash_profile" <<EOF

$marker
export BASH_ENV="$environment"
. "\$BASH_ENV"
EOF
}

step 'Check system packages' install_system_packages
step 'Install Nix when needed' install_nix
activate_nix
step 'Build and install the locked slim development profile' \
  ./scripts/install-dev-profile --slim
step 'Configure the orb shell environment' install_shell_environment

printf '\nOrb setup complete.\n'
