#!/usr/bin/env python3
"""Print fresh luv wiki figure IDs."""

from __future__ import annotations

import argparse
import re
import secrets
from pathlib import Path


ID_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
ID_PATTERN = re.compile(r"(?:#|id:|:ID:\s*)([A-Z0-9]{6})")


def default_root() -> Path:
    path = Path(__file__).resolve()
    for parent in path.parents:
        if (parent / "wiki").is_dir():
            return parent
    raise SystemExit("could not find repository root containing wiki/")


def used_ids(root: Path) -> set[str]:
    ids: set[str] = set()
    for path in (root / "wiki").rglob("*.org"):
        text = path.read_text(encoding="utf-8")
        ids.update(match.group(1) for match in ID_PATTERN.finditer(text))
    return ids


def fresh_id(used: set[str]) -> str:
    while True:
        candidate = "".join(secrets.choice(ID_CHARS) for _ in range(6))
        if candidate not in used:
            used.add(candidate)
            return candidate


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Print fresh six-character luv wiki figure IDs."
    )
    parser.add_argument("count", nargs="?", type=int, default=12)
    parser.add_argument(
        "--root",
        type=Path,
        default=default_root(),
        help="repository root containing wiki/ (default: auto-detected)",
    )
    args = parser.parse_args()
    if args.count < 1:
        raise SystemExit("count must be positive")
    used = used_ids(args.root)
    for _ in range(args.count):
        print(fresh_id(used))


if __name__ == "__main__":
    main()
