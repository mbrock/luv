# The checkout's environment, entered automatically.
#
# `use flake` is nix-direnv's, and nix-direnv is what makes this cheap: it
# caches the evaluated shell and re-evaluates only when flake.nix or
# flake.lock changes, so entering the directory costs nothing and a changed
# environment cannot go unnoticed.
#
# Run `direnv allow` once per checkout.  Non-interactive callers -- CI, cron,
# an agent's one-shot shell -- have no direnv hook and should use
# `nix develop -c CMD` or `direnv exec . CMD` instead.

use flake

# The ordinary tailnet showcase topology.  Every value remains overrideable
# in a parent environment, but linked worktrees share useful defaults without
# acquiring a private configuration file.
export LUV_SHOWCASE_RENDER_HOST="${LUV_SHOWCASE_RENDER_HOST:-chapel}"
export LUV_SHOWCASE_RENDER_CHECKOUT="${LUV_SHOWCASE_RENDER_CHECKOUT:-luv-showcase}"
export LUV_SHOWCASE_RENDER_MEDIA_CHECKOUT="${LUV_SHOWCASE_RENDER_MEDIA_CHECKOUT:-luv-showcase-media}"
export LUV_SHOWCASE_WEB_HOST="${LUV_SHOWCASE_WEB_HOST:-swa}"
export LUV_SHOWCASE_WEB_CHECKOUT="${LUV_SHOWCASE_WEB_CHECKOUT:-/srv/luv}"
export LUV_SHOWCASE_WEB_MEDIA_CHECKOUT="${LUV_SHOWCASE_WEB_MEDIA_CHECKOUT:-/var/www/luv/showcase}"
export LUV_SHOWCASE_WEB_SERVICE="${LUV_SHOWCASE_WEB_SERVICE:-luvcraft-web.service}"
