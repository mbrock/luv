# The installed luv development profile is a deliberate stable checkpoint.
# Entering a checkout merely reads its already-built activation file: no flake
# evaluation, network lookup, or Nix subshell belongs on the edit/test path.
# Refresh the profile explicitly with ./scripts/install-dev-profile when
# flake.nix or flake.lock changes.

luv_profile_environment="${LUV_PROFILE_ENVIRONMENT:-$HOME/.nix-profile/share/luv/env.sh}"
if [ ! -r "$luv_profile_environment" ]; then
  log_error "luv development profile missing; run ./scripts/install-dev-profile"
  return 1
fi
# env.sh owns activation, including putting the profile's bin first on PATH.
. "$luv_profile_environment"

export LUV_PROJECT_ROOT="$PWD"
case ":${CL_SOURCE_REGISTRY:-}:" in
  *:"$LUV_PROJECT_ROOT/":*) ;;
  *) export CL_SOURCE_REGISTRY="$LUV_PROJECT_ROOT/:${CL_SOURCE_REGISTRY:-}" ;;
esac

# The ordinary tailnet showcase topology.  Every value remains overrideable
# in a parent environment, but linked worktrees share useful defaults without
# acquiring a private configuration file.
export LUV_SHOWCASE_RENDER_HOST="${LUV_SHOWCASE_RENDER_HOST:-chapel}"
export LUV_SHOWCASE_RENDER_CHECKOUT="${LUV_SHOWCASE_RENDER_CHECKOUT:-luv-showcase}"
export LUV_SHOWCASE_RENDER_MEDIA_CHECKOUT="${LUV_SHOWCASE_RENDER_MEDIA_CHECKOUT:-luv-showcase-media}"
export LUV_SHOWCASE_WEB_HOST="${LUV_SHOWCASE_WEB_HOST:-swa}"
export LUV_SHOWCASE_WEB_CHECKOUT="${LUV_SHOWCASE_WEB_CHECKOUT:-/srv/luv}"
export LUV_SHOWCASE_WEB_MEDIA_CHECKOUT="${LUV_SHOWCASE_WEB_MEDIA_CHECKOUT:-/var/www/luv/showcase}"
export LUV_SHOWCASE_WEB_SERVICE="${LUV_SHOWCASE_WEB_SERVICE:-luvcraft-web.service}"
