;;; A tiny game-owned overlay, not an atelier dependency. Rectangles include
;;; the bitmap lettering; lines are quads so every backend agrees on width.
(defpackage #:luft.wizard.shaders
  (:use #:cl #:luv.shader)
  (:shadowing-import-from #:luv.shader #:step))
(in-package #:luft.wizard.shaders)

(define-live-shader hud-vertex
    (:stage :vertex
     :inputs ((vertex-index :uint :built-in :vertex-index)
              (instance-index :uint :built-in :instance-index))
     :outputs ((position :vec4 :built-in :position)
               (ink :vec4 :location 0))
     :resources ((rects :storage-buffer :binding 0 :element :vec4)))
  (let* ((base (* instance-index (uint 3.0)))
         (a (buffer-element rects base))
         (b (buffer-element rects (+ base (uint 1.0))))
         (i (float vertex-index))
         (corner (vec2 (if (= i 2.0) 1.0 (if (= i 3.0) 1.0 (if (= i 5.0) 1.0 0.0)))
                       (if (= i 1.0) 1.0 (if (= i 4.0) 1.0 (if (= i 5.0) 1.0 0.0)))))
         (point (+ (swizzle a :xy) (* (swizzle a :zw) (swizzle corner :x))
                   (* (swizzle b :xy) (swizzle corner :y)))))
    (set-output position (vec4 point 0.0 1.0))
    (set-output ink (buffer-element rects (+ base (uint 2.0))))))

(define-live-shader hud-fragment
    (:stage :fragment :inputs ((ink :vec4 :location 0))
     :outputs ((color :vec4 :location 0)))
  (set-output color ink))

(in-package #:luft.wizard)

(defparameter *wizard-lettering*
  '( (#\A 14 17 17 31 17 17 17) (#\B 30 17 17 30 17 17 30)
     (#\C 14 17 16 16 16 17 14) (#\D 30 17 17 17 17 17 30)
     (#\E 31 16 16 30 16 16 31) (#\F 31 16 16 30 16 16 16)
     (#\G 14 17 16 23 17 17 15) (#\H 17 17 17 31 17 17 17)
     (#\I 14 4 4 4 4 4 14) (#\J 7 2 2 2 18 18 12)
     (#\K 17 18 20 24 20 18 17) (#\L 16 16 16 16 16 16 31)
     (#\M 17 27 21 21 17 17 17) (#\N 17 25 21 19 17 17 17)
     (#\O 14 17 17 17 17 17 14) (#\P 30 17 17 30 16 16 16)
     (#\Q 14 17 17 17 21 18 13) (#\R 30 17 17 30 20 18 17)
     (#\S 15 16 16 14 1 1 30) (#\T 31 4 4 4 4 4 4)
     (#\U 17 17 17 17 17 17 14) (#\V 17 17 17 17 17 10 4)
     (#\W 17 17 17 21 21 21 10) (#\X 17 17 10 4 10 17 17)
     (#\Y 17 17 10 4 4 4 4) (#\Z 31 1 2 4 8 16 31)
     (#\0 14 17 19 21 25 17 14) (#\1 4 12 4 4 4 4 14)
     (#\2 14 17 1 2 4 8 31) (#\3 30 1 1 14 1 1 30)
     (#\4 2 6 10 18 31 2 2) (#\5 31 16 16 30 1 1 30)
     (#\6 14 16 16 30 17 17 14) (#\7 31 1 2 4 8 8 8)
     (#\8 14 17 17 14 17 17 14) (#\9 14 17 17 15 1 1 14)
     (#\/ 1 2 2 4 8 8 16) (#\- 0 0 0 31 0 0 0)
     (#\. 0 0 0 0 0 12 12)))

(defun wizard-project (wizard x y z width height)
  "Project a world point into the unjittered logical overlay."
  (multiple-value-bind (right up) (render:camera-basis (wizard-camera wizard))
    (let* ((eye (render:camera-position (wizard-camera wizard)))
           (dx (- x (vec3-x eye))) (dy (- y (vec3-y eye)))
           (dz (- z (vec3-z eye)))
           (scale (/ height (wizard-isometric-height wizard))))
      (list (+ (/ width 2) (* scale (+ (* dx (vec3-x right))
                                       (* dy (vec3-y right)) (* dz (vec3-z right)))))
            (- (/ height 2) (* scale (+ (* dx (vec3-x up))
                                       (* dy (vec3-y up)) (* dz (vec3-z up)))))))))

(defun wizard-hud-data (wizard width height)
  (let ((data (make-array 4096 :element-type 'single-float
                              :adjustable t :fill-pointer 0))
        (gold '(1.0 0.72 0.28 1.0))
        (white '(0.88 0.93 0.87 1.0))
        (green '(0.40 1.0 0.70 1.0))
        (red '(1.0 0.32 0.25 1.0)))
    (labels
        ((quad (x y rx ry ux uy color)
           (dolist (n (append (list (- (* 2 (/ x width)) 1) (- (* 2 (/ y height)) 1)
                                   (* 2 (/ rx width)) (* 2 (/ ry height))
                                   (* 2 (/ ux width)) (* 2 (/ uy height)) 0 0)
                             color))
             (vector-push-extend (coerce n 'single-float) data)))
         (rect (x y w h color) (quad x y w 0 0 h color))
         (line (a b color &optional (thickness 2))
           (let* ((dx (- (first b) (first a))) (dy (- (second b) (second a)))
                  (length (max 0.001 (sqrt (+ (* dx dx) (* dy dy)))))
                  (nx (* thickness (/ (- dy) length)))
                  (ny (* thickness (/ dx length))))
             (quad (- (first a) (/ nx 2)) (- (second a) (/ ny 2))
                   dx dy nx ny color)))
         (text (string x y color &optional (scale 2))
           (loop for c across string for cx from x by (* 6 scale) do
             (loop for row in (cdr (assoc c *wizard-lettering*)) for j from 0 do
               (dotimes (i 5)
                 (when (logbitp (- 4 i) row)
                   (rect (+ cx (* i scale)) (+ y (* j scale)) scale scale color))))))
         (cell (x y z color)
           (let ((corners (loop for (dx dy) in '((0 0) (1 0) (1 1) (0 1))
                                collect (wizard-project wizard (+ x dx) (+ y dy)
                                                        (+ z 0.04) width height))))
             (loop for a in corners for b in (append (cdr corners) (list (car corners)))
                   do (line a b color)))))
      ;; Ground selection updates even while the camera follows a route.
      (setf (wizard-hover wizard)
            (when (wizard-pointer wizard)
              (multiple-value-bind (x y z)
                  (apply #'wizard-pointed-cell wizard (wizard-pointer wizard))
                (when x (list x y z)))))
      (let ((hover (wizard-hover wizard)))
        (when hover (apply #'cell (append hover (list green))))
        (when (wizard-pointer wizard)
          (destructuring-bind (x y) (wizard-pointer wizard)
            (let ((color (if hover green red)))
              (line (list (- x 9) y) (list (- x 3) y) color)
              (line (list (+ x 3) y) (list (+ x 9) y) color)
              (line (list x (- y 9)) (list x (- y 3)) color)
              (line (list x (+ y 3)) (list x (+ y 9)) color)))))
      (let ((route (terrain:character-controller (wizard-character wizard))))
        (when (and (typep route 'terrain:walking-route)
                   (eq :running (terrain:walking-route-status route)))
          (dolist (site (terrain:walking-route-cells route))
            (destructuring-bind (x y)
                (wizard-project wizard (+ 0.5 (luft:site-x site))
                                (+ 0.5 (luft:site-y site)) (+ 0.06 (luft:site-z site))
                                width height)
              (rect (- x 2) (- y 2) 4 4 gold)))))
      ;; Waymarks intentionally stay visible through scenery and clamp to the
      ;; viewport edge: a compass, not a second world-space object.
      (let ((beacon (wizard-next-beacon wizard)))
        (when beacon
          (destructuring-bind (name x y) beacon
            (destructuring-bind (sx sy)
                (wizard-project wizard (+ x 0.5) (+ y 0.5)
                                (+ 2 (wizard-ground-height x y)) width height)
              (let ((px (max 38 (min (- width 90) sx)))
                    (py (max 150 (min (- height 110) sy))))
                (line (list px (- py 8)) (list (+ px 8) py) gold)
                (line (list (+ px 8) py) (list px (+ py 8)) gold)
                (line (list px (+ py 8)) (list (- px 8) py) gold)
                (line (list (- px 8) py) (list px (- py 8)) gold)
                (text name (+ px 14) (- py 6) gold))))))
      (rect 16 16 (- width 32) 105 '(0.025 0.045 0.05 0.94))
      (rect 16 16 4 105 gold)
      (text "THE EMBER WALK" 34 30 gold 3)
      (text (wizard-objective wizard) 34 65 white)
      (text (wizard-message wizard) 34 93 gold 1.5)
      (rect 16 (- height 58) (- width 32) 42 '(0.025 0.045 0.05 0.94))
      (text "CLICK WALK   SPACE EMBER   Q/E TURN   WHEEL ZOOM   R RETURN"
            32 (- height 44) white 1.5)
      (text "CIRCLE - RIDGE - POND. BRING THREE OLD PLINTHS BACK TO LIGHT."
            32 (- height 29) gold 1)
      ;; A brief expanding sigil acknowledges a successful cast.
      (when (wizard-spell-time wizard)
        (let ((age (- (or (wizard-last-timestamp wizard) 0) (wizard-spell-time wizard))))
          (when (< age 1.2)
            (let* ((feet (terrain:body-position (terrain:character-body (wizard-character wizard))))
                   (r (+ 0.4 (* age 2))))
              (loop for i below 24
                    for a = (* i (/ (* 2 pi) 24))
                    for b = (* (1+ i) (/ (* 2 pi) 24))
                    do (line (wizard-project wizard (+ (vec3-x feet) (* r (cos a)))
                                             (+ (vec3-y feet) (* r (sin a)))
                                             (+ 0.1 (vec3-z feet)) width height)
                             (wizard-project wizard (+ (vec3-x feet) (* r (cos b)))
                                             (+ (vec3-y feet) (* r (sin b)))
                                             (+ 0.1 (vec3-z feet)) width height) gold)))))))
      data))

(defun release-wizard-hud-slot (wizard surface)
  (let ((key (canvas-frame-resource-key (wizard-context wizard) surface)))
    (dolist (resource (gethash key (wizard-hud-slots wizard))) (destroy resource))
    (remhash key (wizard-hud-slots wizard))))

(defun encode-wizard-hud (wizard pass surface)
  (destructuring-bind (width height) (wizard-logical-extent wizard)
    (let* ((data (wizard-hud-data wizard width height))
           (device (wizard-device wizard))
           (program
             (or (wizard-hud-program wizard)
                 (setf (wizard-hud-program wizard)
                       (render:make-drawing-program
                        device :label "ember walk HUD"
                        :vertex (luft.wizard.shaders::hud-vertex)
                        :fragment (luft.wizard.shaders::hud-fragment)
                        :targets `((:format ,(canvas-format (wizard-context wizard))
                                    :blend :premultiplied-alpha))))))
           (key (canvas-frame-resource-key (wizard-context wizard) surface))
           (resources (gethash key (wizard-hud-slots wizard))))
      ;; Presentation slots are fenced before reuse. Keep their bindings alive
      ;; through submit, and never overwrite a buffer borrowed by another slot.
      (unless resources
        (let ((buffer (create device (make-buffer-descriptor
                                     :label "ember HUD quads" :size (* 4 262144)
                                     :usage '(:storage :copy-dst)))))
          (handler-case
              (setf resources (list (render:make-program-binding program device :rects buffer)
                                    buffer)
                    (gethash key (wizard-hud-slots wizard)) resources)
            (error (condition) (destroy buffer) (error condition)))))
      (assert (<= (length data) 262144))
      (write-buffer (second resources) data)
      (render:encode-program program pass (first resources)
                             (make-gpu-draw-command :vertex-count 6
                                                   :instance-count (/ (length data) 12))))))
