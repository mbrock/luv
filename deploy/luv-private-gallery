#!/bin/sh
# Materialize the private annex-backed gallery for Caddy without exposing .git.

set -eu

checkout=/srv/luv
gallery=/srv/luv-private-gallery
source_path=private/knuth
remote=swa-private

annex_bin=$(
    runuser -u mbrock -- env HOME=/home/mbrock \
        PATH=/nix/var/nix/profiles/default/bin:/usr/bin:/bin \
        nix develop "path:$checkout/nix#annex" --no-write-lock-file \
        -c sh -c 'dirname "$(command -v git-annex)"'
)
as_mbrock()
{
    runuser -u mbrock -- env HOME=/home/mbrock \
        PATH="$annex_bin:/usr/bin:/bin" "$@"
}

test "$(as_mbrock git -C "$checkout" config --bool remote.origin.annex-ignore)" = true || {
    echo "luv-private-gallery: origin must remain annex-ignored" >&2
    exit 1
}
as_mbrock git -C "$checkout" annex get --from "$remote" -- "$source_path"
missing=$(as_mbrock git -C "$checkout" annex find --not --in here -- "$source_path")
test -z "$missing" || {
    echo "luv-private-gallery: annex content is missing:" >&2
    printf '%s\n' "$missing" >&2
    exit 1
}

release=$(as_mbrock git -C "$checkout" rev-parse HEAD)
destination=$gallery/releases/$release
install -d -o mbrock -g caddy -m 0750 "$gallery"
install -d -o mbrock -g caddy -m 0750 "$gallery/releases"
if [ ! -d "$destination" ]; then
    staging=$gallery/.release.$release.$$
    trap 'rm -rf "$staging"' EXIT HUP INT TERM
    install -d -o mbrock -g caddy -m 0750 "$staging"
    cp -RL "$checkout/$source_path/." "$staging/"
    find "$staging" -type d -exec chmod 0750 {} +
    find "$staging" -type f -exec chmod 0640 {} +
    chown -R mbrock:caddy "$staging"
    mv "$staging" "$destination"
    trap - EXIT HUP INT TERM
fi
ln -sfn "releases/$release" "$gallery/current.next"
mv -Tf "$gallery/current.next" "$gallery/current"
