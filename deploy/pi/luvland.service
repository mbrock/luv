[Unit]
Description=Luvland, the Common Lisp Wayland compositor, on tty1
Documentation=https://github.com/mbrock/luv/blob/main/wiki/compositor.org
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=mbrock
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/home/mbrock/.local/bin/luvland-session
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
