;;;; Independent numeric/table checks; no window or durable image.
(require :asdf)
(asdf:load-system "luft/renderer")
(load "wiki/measurements/yawl-bevel-retirement-2a231b9/probe.lisp")
(in-package #:luft.render)

(let* ((tables (multiple-value-list (retirement-tables)))
       (words (first tables)) (indices (third tables)) (ranges (sixth tables))
       (control (multiple-value-list (star-patch-tables t)))
       (max-offset 0))
  (assert (equalp (fourth tables) (fourth control)))
  (assert (equalp (fifth tables) (fifth control)))
  (dotimes (star 256)
    (dotimes (tier 2)
      (let* ((triangles (if (zerop tier) (luft:star-atlas-owned-triangles star)
                           (luft:star-atlas-flat-owned-triangles star)))
             (range (aref ranges (+ star (* tier 256))))
             (decoded
               (loop for index from (aref range 0) below (+ (aref range 0) (aref range 1))
                     for base = (* 4 (aref indices index))
                     collect (loop for axis below 3 collect (- (aref words (+ base axis)) 8)))))
        (assert (equal decoded (apply #'append triangles)))))
    (dolist (triangle (luft:star-atlas-owned-triangles star))
      (dolist (point triangle)
        (let ((delta (mapcar (lambda (c) (- c (luft::%flat-face-coordinate c))) point)))
          (assert (equal (mapcar #'luft::%flat-face-coordinate point)
                         (mapcar (lambda (c) (* 8 (floor (+ (/ c 8) 1/2)))) point)))
          (setf max-offset (max max-offset (/ (reduce #'+ (mapcar (lambda (x) (* x x)) delta)) 64)))))))
  (assert (< (sqrt max-offset) 0.176777))
  (format t "~&All 512 decoded patches and shadow arrays match; maximum offset ~F cells.~%"
          (sqrt max-offset)))

;; Compare the conservative site selector against actual perspective projection
;; at every anchor and the signed two-axis offsets enclosing the actual atlas.
;; These are deliberately
;; off-axis, near-plane, threshold-crossing, and behind-camera cases.
(let ((data (make-array 136 :element-type 'single-float :initial-element 0.0))
      (checks 0) (selected 0))
  (setf (aref data 4) 1.0 (aref data 9) 1.0 (aref data 14) 1.0
        (aref data 16) 1.3 (aref data 17) 2.1 (aref data 22) 1.0
        (aref data 50) (/ 1920.0) (aref data 51) (/ 1080.0))
  (dolist (x '(-93.0 -7.0 0.0 39.0))
    (dolist (y '(-47.0 0.0 13.0))
      (dolist (z '(-2.0 0.0 0.2 7.0 49.0 149.0 400.0 900.0))
        (let ((bound (retirement-bound x y z data)))
          (dolist (limit '(1.0 2.0 4.0))
            (when (< bound (- limit 0.001)) (incf selected)))
          (dotimes (corner 8)
            (let* ((ax (+ x (logand corner 1)))
                   (ay (+ y (ldb (byte 1 1) corner)))
                   (az (+ z (ldb (byte 1 2) corner)))
                   (r 0.176777)
                   (safe-z (max 0.001 az))
                   (sx (/ ax safe-z))
                   (sy (/ ay safe-z))
                   (corner-bound (/ (* r 1248.0 (sqrt (+ 1.0 (* sx sx) (* sy sy))))
                                    (max 0.001 (- az r)))))
              (assert (<= corner-bound (+ bound 0.01)))
              (when (> az r)
                (dotimes (zero-axis 3)
                  (dotimes (offset 8)
                    (let* ((dx (if (= zero-axis 0) 0.0 (if (logbitp 0 offset) 0.125 -0.125)))
                           (dy (if (= zero-axis 1) 0.0 (if (logbitp 1 offset) 0.125 -0.125)))
                           (dz (if (= zero-axis 2) 0.0 (if (logbitp 2 offset) 0.125 -0.125)))
                           (px (* 1248.0 (- (/ (+ ax dx) (+ az dz)) (/ ax az))))
                           (py (* 1134.0 (- (/ (+ ay dy) (+ az dz)) (/ ay az)))))
                      (assert (<= (sqrt (+ (* px px) (* py py))) (+ corner-bound 0.01)))
                      (incf checks)))))))))))
  (assert (plusp selected))
  (format t "~&~D actual offset projections bounded; ~D flat selection cases exercised.~%"
          checks selected))
