;;;; Bounded planar proxies. No fragment-depth writes or triangle fallback.
(defpackage #:analytic-gpu
  (:use #:cl)
  (:local-nicknames (#:s #:luv.shader) (#:r #:luft.render)))
(in-package #:analytic-gpu)

(s:define-shader vertex-specification
    (:stage :vertex
     :inputs ((vertex-index :uint :built-in :vertex-index)
              (instance-index :uint :built-in :instance-index))
     :outputs ((clip :vec4 :built-in :position)
               (world-coordinate :vec3 :location 0)
               (local-coordinate :vec3 :location 1)
               (normal-patch :vec4 :location 2 :interpolation :flat)
               (material :float :location 3 :interpolation :flat)
               (ray-anchor :vec4 :location 4 :interpolation :flat))
     :resources ((vertices :storage-buffer :binding 0 :element :vec4)
                 (camera :storage-buffer :binding 1 :element :vec4)))
  (let* ((record (s:buffer-element vertices (* vertex-index (s:uint 2.0))))
         (normal (s:buffer-element vertices (+ (* vertex-index (s:uint 2.0))
                                              (s:uint 1.0))))
         (eye (s:buffer-element camera (s:uint 0.0)))
         (right (s:buffer-element camera (s:uint 1.0)))
         (up (s:buffer-element camera (s:uint 2.0)))
         (forward (s:buffer-element camera (s:uint 3.0)))
         (light (s:buffer-element camera (s:uint 4.0)))
         (grid (s:buffer-element camera (s:uint 5.0)))
         (side (s:uint (s:swizzle grid :x)))
         (half (* 0.5 (- (s:swizzle grid :x) 1.0)))
         (dx (* (- (s:float (mod instance-index side)) half) (s:swizzle grid :y)))
         (dy (* (- (s:float (/ instance-index side)) half) (s:swizzle grid :y)))
         (offset (+ (* dx (s:swizzle right :xyz)) (* dy (s:swizzle up :xyz))))
         (point (+ (s:swizzle record :xyz) offset))
         (relative (- point (s:swizzle eye :xyz)))
         (z (s:dot relative (s:swizzle forward :xyz)))
         (w (if (> (s:swizzle eye :w) 0.5) z 1.0)))
    ;; The portable clip convention is Y down; MSL lowering flips it.
    (s:set-output clip
                  (s:vec4 (* (s:dot relative (s:swizzle right :xyz)) (s:swizzle right :w))
                          (- (* (s:dot relative (s:swizzle up :xyz)) (s:swizzle up :w)))
                          (+ (* z (s:swizzle forward :w)) (s:swizzle light :w)) w))
    (s:set-output world-coordinate point)
    (s:set-output local-coordinate (s:swizzle record :xyz))
    (s:set-output normal-patch normal)
    (s:set-output material (s:swizzle record :w))
    (s:set-output ray-anchor
                  (s:vec4 (- (s:swizzle eye :xyz) offset)
                          (s:dot (s:swizzle record :xyz) (s:swizzle normal :xyz))))))

(s:define-shader-function surface-color (normal material light view)
  (let* ((pigment (if (< material 0.5) (s:vec3 0.44 0.23 0.095)
                      (if (< material 1.5) (s:vec3 0.18 0.32 0.11)
                          (if (< material 2.5) (s:vec3 0.12 0.19 0.43)
                              (s:vec3 0.54 0.10 0.12)))))
         (diffuse (max 0.0 (s:dot normal light)))
         (halfway (s:normalize (+ light view)))
         (specular (expt (max 0.0 (s:dot normal halfway)) 48.0))
         (ambient (+ 0.16 (* 0.10 (+ 0.5 (* 0.5 (s:swizzle normal :z)))))))
    (+ (* pigment (+ ambient (* 0.85 diffuse)))
       (* (s:vec3 1.0 1.0 1.0) (if (> diffuse 0.0) 0.65 0.0) specular))))

(defun fragment-specification (analytic-p diagnostics-p)
  ;; Fixed eight halfspaces, not an unbounded polygon loop. Padded edges
  ;; accept every point. The quad is coplanar: depth is hardware-interpolated.
  (s:parse-shader-specification
   (if analytic-p 'analytic-fragment 'indexed-fragment)
   `(:stage :fragment
     :inputs ((world-coordinate :vec3 :location 0)
              (local-coordinate :vec3 :location 1)
              (normal-patch :vec4 :location 2 :interpolation :flat)
              (material :float :location 3 :interpolation :flat)
              (ray-anchor :vec4 :location 4 :interpolation :flat)
              (pixel :vec4 :built-in :frag-coord))
     :outputs ((color :vec4 :location 0)
               ,@(when diagnostics-p '((hit :vec4 :location 1))))
     :resources ((camera :storage-buffer :binding 1 :element :vec4)
                 ,@(when analytic-p '((edges :storage-buffer :binding 2 :element :vec4)))))
   `((let* ((eye (s:buffer-element camera (s:uint 0.0)))
            (forward (s:buffer-element camera (s:uint 3.0)))
            (light (s:normalize (s:swizzle (s:buffer-element camera (s:uint 4.0)) :xyz)))
            (normal (s:swizzle normal-patch :xyz))
            (view (if (> (s:swizzle eye :w) 0.5)
                      (s:normalize (- (s:swizzle eye :xyz) world-coordinate))
                      (- (s:swizzle forward :xyz)))))
       (when (<= (s:dot normal view) 0.0) (s:discard))
       ,@(when analytic-p
           `((let* ((base (* (s:uint (s:swizzle normal-patch :w)) (s:uint 8.0)))
                    ;; Interpolated coordinates follow raster-snapped proxy
                    ;; edges and can reject an interior sample beside a join.
                    ;; Reconstruct the actual sample ray before domain tests.
                    (right (s:buffer-element camera (s:uint 1.0)))
                    (up (s:buffer-element camera (s:uint 2.0)))
                    (grid (s:buffer-element camera (s:uint 5.0)))
                    (x (/ (- (/ (* 2.0 (s:swizzle pixel :x)) (s:swizzle grid :z)) 1.0)
                          (s:swizzle right :w)))
                    (y (/ (- 1.0 (/ (* 2.0 (s:swizzle pixel :y)) (s:swizzle grid :w)))
                          (s:swizzle up :w)))
                    (offset (+ (* x (s:swizzle right :xyz)) (* y (s:swizzle up :xyz))))
                    (perspective (> (s:swizzle eye :w) 0.5))
                    (origin (if perspective (s:swizzle ray-anchor :xyz)
                                (+ (s:swizzle ray-anchor :xyz) offset)))
                    (direction (if perspective (+ (s:swizzle forward :xyz) offset)
                                   (s:swizzle forward :xyz)))
                    (distance (/ (- (s:swizzle ray-anchor :w) (s:dot normal origin))
                                 (s:dot normal direction)))
                    (point (s:vec4 (+ origin (* distance direction)) 1.0)))
               (when (< (min ,@(loop for i below 8 collect
                                `(s:dot point (s:buffer-element edges (+ base (s:uint ,(float i)))))))
                        0.0)
                 (s:discard)))))
       (s:set-output color (s:vec4 (surface-color normal material light view) 1.0))
       ,@(when diagnostics-p
           '((s:set-output hit (s:vec4 normal (+ material 1.0)))))))))
