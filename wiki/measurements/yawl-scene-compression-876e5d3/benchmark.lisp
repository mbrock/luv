(require :asdf)
;; Disposable process only. This replaces drawing methods until exit.
(assert (uiop:getenv "BENCH_LIBRARY") () "Set BENCH_LIBRARY=1 before running this probe.")
(load "scripts/bench-gpu-fps.lisp")
(when (uiop:getenv "SCENE_FLAT")
  (setf luft.render::*terrain-bevels-p* nil))
(let ((original (symbol-function 'gpu-fps::run-case)))
  (setf (symbol-function 'gpu-fps::run-case)
        (lambda (kind backend width height)
          (unless (eq backend :old) (funcall original kind backend width height)))))
(unless (equal (uiop:getenv "SCENE_MERGE") "0")
  (load (merge-pathnames "batch.lisp" *load-truename*))
  (unless (equal (uiop:getenv "SCENE_MERGE") "batch")
    (load (merge-pathnames "compress.lisp" *load-truename*))))
(gpu-fps::main)
