(require :asdf)
(assert (uiop:getenv "BENCH_LIBRARY") () "Set BENCH_LIBRARY=1 before running this probe.")
(load "scripts/bench-gpu-fps.lisp")
(load (merge-pathnames "batch.lisp" *load-truename*))
(load (merge-pathnames "compress.lisp" *load-truename*))
(in-package #:terrain-batch-probe)

(defun array-signature (sites appearances lights words references indices)
  ;; Independent observable oracle: oriented tick-length boundary segments
  ;; per plane/material/constant light. Nonconstant light triangles must
  ;; remain literally unchanged, including their corner illumination.
  (let ((signature (make-hash-table :test #'equal)))
    (labels ((corner (index)
               (let* ((site (* 4 (aref references (* index 2))))
                      (vertex (* 4 (aref references (1+ (* index 2)))))
                      (w (aref words (+ vertex 3)))
                      (mask (ldb (byte 8 0) w))
                      (point (loop for axis below 3
                                   collect (+ (* 8 (aref sites (+ site axis)))
                                              (- (aref words (+ vertex axis)) 8))))
                      (p (loop for axis below 3
                               when (> (aref words (+ vertex axis)) 11)
                                 sum (expt 2 axis)))
                      (codes (loop for bit below 8
                                   when (logbitp bit mask)
                                     collect (ldb (byte 8 (* 8 (mod bit 4)))
                                                  (aref appearances
                                                        (+ (/ site 2) (floor bit 4))))))
                      (selected (remove 0 codes)))
                 (list point
                       (ldb (byte 16 (* 16 (mod p 2)))
                            (aref lights (+ site (floor p 2))))
                       ;; Ordered nonzero material contributions, exact
                       ;; occupied/empty ratio and chosen material code.
                       (list selected
                             (/ (logcount mask)
                                (max 1 (+ (logcount mask)
                                          (logcount (ldb (byte 8 8) w)))))))))
             (edge (key a b)
               (let* ((delta (mapcar #'- b a))
                      (steps (abs (reduce #'gcd delta)))
                      (step (mapcar (lambda (v) (/ v steps)) delta)))
                 (dotimes (i steps)
                   (let* ((p (mapcar (lambda (v d) (+ v (* i d))) a step))
                          (q (mapcar #'+ p step))
                          (forward (list key p q)) (back (list key q p)))
                     (if (gethash back signature)
                         (when (zerop (decf (gethash back signature)))
                           (remhash back signature))
                         (incf (gethash forward signature 0))))))))
      (loop for i from 0 below (length indices) by 3
            for corners = (loop for j below 3 collect (corner (aref indices (+ i j))))
            for points = (mapcar #'first corners)
            for normal = (r::star-triangle-normal-key points)
            for base = (list normal (point-dot normal (first points)))
            do (if (and (equal (rest (first corners)) (rest (second corners)))
                        (equal (rest (first corners)) (rest (third corners))))
                   (let ((key (list base (rest (first corners)))))
                     (loop for a in points for b in (append (rest points) (list (first points)))
                           do (edge key a b)))
                   (incf (gethash (list :gradient base corners) signature 0))))
      signature)))

(defun mesh-boundary (sites words references indices)
  (let ((edges (make-hash-table :test #'equal)))
    (labels ((point (index)
               (let ((site (* 4 (aref references (* 2 index))))
                     (vertex (* 4 (aref references (1+ (* 2 index))))))
                 (loop for axis below 3 collect
                   (+ (* 8 (aref sites (+ site axis)))
                      (- (aref words (+ vertex axis)) 8))))))
      (loop for i from 0 below (length indices) by 3
            for points = (loop for j below 3 collect (point (aref indices (+ i j))))
            do (loop for a in points for b in (append (rest points) (list (first points)))
                     for edge = (list a b) for reverse = (list b a)
                     do (if (gethash reverse edges)
                            (when (zerop (decf (gethash reverse edges)))
                              (remhash reverse edges))
                            (incf (gethash edge edges 0))))))
    edges))

(defun check-population (sites appearances lights)
  (let* ((population (r::%make-render-population
                      sites appearances (make-array 32 :element-type '(unsigned-byte 32)
                                                        :initial-element 0)
                      (/ (length sites) 4) lights))
         (drawing (make-instance 'r:terrain-drawing)))
    (multiple-value-bind (words normals atlas sw si ranges)
        (r::star-patch-tables r::*terrain-bevels-p*)
      (declare (ignore normals atlas sw si))
      (setf (r::terrain-star-ranges drawing) ranges)
      (multiple-value-bind (sorted app runs light) (r::sort-sites-by-star sites appearances lights)
        (multiple-value-bind (refs indices) (batch-arrays (drawing-patches drawing) runs)
          (let ((before (array-signature sorted app light words refs indices)))
            (multiple-value-bind (new-refs new-indices) (compressed-arrays drawing population)
              (let ((after (array-signature sorted app light words new-refs new-indices)))
                (assert (equalp before after))
                ;; Unlike the split-edge signature, this catches T-junctions
                ;; and changes to unmatched edges at resident boundaries.
                (assert (equalp (mesh-boundary sorted words refs indices)
                                (mesh-boundary sorted words new-refs new-indices)))
                (assert (<= (length new-indices) (length indices)))))))))
    (clrhash *patches*)))

(defun check-voxel-field (occupied varied-material varied-light)
  (let ((sites nil) (appearances nil) (lights nil))
    (dotimes (z 7)
      (dotimes (y 7)
        (dotimes (x 7)
          (let ((star 0) (appearance 0) (light 0))
            (dotimes (bit 8)
              (let ((cell (list (+ x (ldb (byte 1 0) bit) -1)
                                (+ y (ldb (byte 1 1) bit) -1)
                                (+ z (ldb (byte 1 2) bit) -1))))
                (when (gethash cell occupied)
                  (setf (ldb (byte 1 bit) star) 1
                        (ldb (byte 8 (* 8 bit)) appearance)
                        (if varied-material (1+ (mod (reduce #'+ cell) 3)) 1)))
                (setf (ldb (byte 16 (* bit 16)) light)
                      (if varied-light (logior #x8000 (* 17 (+ x (* 2 y) (* 3 z) bit))) #xf000))))
            (when (< 0 star 255)
              (setf sites (nconc sites (list (+ x 8) (+ y 9) (+ z 7) star))
                    appearances (nconc appearances
                                       (list (ldb (byte 32 0) appearance)
                                             (ldb (byte 32 32) appearance)))
                    lights (nconc lights (loop for lane below 4
                                              collect (ldb (byte 32 (* 32 lane)) light)))))))))
    (flet ((words (list) (make-array (length list) :element-type '(unsigned-byte 32)
                                                :initial-contents list)))
      (check-population (words sites) (words appearances) (words lights)))))

(let ((state (sb-ext:seed-random-state 20261023)) (checks 0))
  (dolist (bevels '(t nil))
    (let ((r::*terrain-bevels-p* bevels))
      (let ((sites (make-array 1024 :element-type '(unsigned-byte 32)))
            (appearances (make-array 512 :element-type '(unsigned-byte 32) :initial-element 0))
            (lights (make-array 1024 :element-type '(unsigned-byte 32)
                                    :initial-element #xf000f000)))
        (dotimes (star 256)
          (replace sites (list (+ 8 (* 4 star)) 9 7 star) :start1 (* 4 star))
          (dotimes (bit 8)
            (when (logbitp bit star)
              (setf (ldb (byte 8 (* 8 (mod bit 4)))
                         (aref appearances (+ (* 2 star) (floor bit 4)))) 1))))
        (check-population sites appearances lights)
        (incf checks))
      (dotimes (case 12)
        (let ((occupied (make-hash-table :test #'equal)))
          (dotimes (x 6)
            (dotimes (y 5)
              (dotimes (z 4)
                (when (case case
                        (0 t)
                        (1 (not (and (= y 2) (= z 2))))
                        (2 (or (= x 0) (= x 5) (= y 0) (= y 4) (= z 0) (= z 3)))
                        (t (< (random 1.0 state) 0.55)))
                  (setf (gethash (list x y z) occupied) t)))))
          (dolist (material '(nil t))
            (dolist (light '(nil t))
              (check-voxel-field occupied material light)
              (incf checks)))))))
  (format t "~&PASS: ~D geometry/material/light boundary comparisons.~%" checks))
