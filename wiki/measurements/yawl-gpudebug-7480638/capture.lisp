(require :asdf)
(assert (uiop:getenv "BENCH_LIBRARY"))
(assert (uiop:getenv "TERRAIN_CAPTURE"))
(load "scripts/bench-gpu-fps.lisp")

(let ((original (symbol-function 'gpu-fps::run-case)))
  (setf (symbol-function 'gpu-fps::run-case)
        (lambda (kind backend width height)
          (unless (eq backend :old)
            (funcall original kind backend width height)))))
(unless (equal (uiop:getenv "SCENE_MERGE") "0")
  (load "wiki/measurements/yawl-scene-compression-876e5d3/batch.lisp")
  (unless (equal (uiop:getenv "SCENE_MERGE") "batch")
    (load "wiki/measurements/yawl-scene-compression-876e5d3/compress.lisp")))
(when (uiop:getenv "TERRAIN_CULL")
  (assert (equal (uiop:getenv "SCENE_MERGE") "0"))
  (load (merge-pathnames "scene-cull.lisp" *load-truename*)))
(when (uiop:getenv "TERRAIN_SETUP")
  (load (uiop:getenv "TERRAIN_SETUP")))

(cffi:load-foreign-library (namestring (truename "build/gpu-capture-probe.dylib")))
(cffi:defcfun ("startCapture" start-capture) :int (device :pointer) (path :string))
(cffi:defcfun ("stopCapture" stop-capture) :void)
(cffi:defcfun ("labelEncoder" label-encoder) :void (encoder :pointer) (label :string))

(defmethod luv:begin-render-pass :around
    ((encoder luv::metal-gpu-command-encoder) (descriptor luv::render-pass-descriptor))
  (let* ((start (gpu-fps::now)) (pass (call-next-method)))
    (setf (gethash pass gpu-fps::*pass-starts*)
          (list nil start (or (luv::gpu-descriptor-label descriptor) "unlabelled")))
    (label-encoder (luv.objective-c:objective-c-pointer
                   (luv::metal-render-pass-native-encoder pass))
                  (or (luv::gpu-descriptor-label descriptor) "unlabelled"))
    pass))

;; This flag must be visible on the canvas thread, not dynamically bound only
;; on the caller. Warmup settles all renderer-derived buffers before capture.
(defvar *capturing* nil)
(let ((original (symbol-function 'gpu-fps::env-integer)))
  (setf (symbol-function 'gpu-fps::env-integer)
        (lambda (name default)
          (cond ((and *capturing* (string= name "BENCH_WARMUP")) 0)
                ((and *capturing* (string= name "BENCH_FRAMES")) 1)
                (t (funcall original name default))))))
(let ((original (symbol-function 'gpu-fps::measure)))
  (setf (symbol-function 'gpu-fps::measure)
        (lambda (kind host old-p width height)
          (assert (not old-p))
          (funcall original kind host old-p width height)
          (let* ((device (luft.render::renderer-device (luft.render:viewer-renderer host)))
                 (pointer (luv.objective-c:objective-c-pointer (luv::metal-native-object device))))
            (assert (plusp (start-capture pointer (uiop:getenv "TERRAIN_CAPTURE"))))
            (unwind-protect
                 (progn (setf *capturing* t)
                        (funcall original kind host old-p width height))
              (setf *capturing* nil)
              (stop-capture))))))
(gpu-fps::main)
(sb-ext:exit :code 0 :abort t)
