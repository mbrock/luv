#!/bin/sh

# Run one clean command in the already-active development profile.

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

. "$project_root/scripts/require-dev-environment"

if [ "${1:-}" = "--status" ]; then
  printf 'checkout: %s\n' "$project_root"
  printf 'environment: active luv development profile\n'
  printf 'SBCL: %s\nSBCL version: ' "$(command -v sbcl)"
  sbcl --version
  printf 'LUV_SLYNK_DIR: %s\n' "${LUV_SLYNK_DIR:-unset}"
  printf 'LUV_SWASH: %s\n' "${LUV_SWASH:-unset}"
  printf 'LUV_GHOSTTY_LIBRARY: %s\n' "${LUV_GHOSTTY_LIBRARY:-unset}"
  printf 'VK_LAYER_PATH: %s\n' "${VK_LAYER_PATH:-unset}"
  printf 'CL_SOURCE_REGISTRY: %s\n' "${CL_SOURCE_REGISTRY:-unset}"
  printf 'ASDF cache: %s/.cache/common-lisp\n' "$HOME"
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- sbcl
fi

exec "$@"
