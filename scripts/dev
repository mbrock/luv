#!/bin/sh

# Run one command in the checkout environment.
#
# This used to be the thing that *built* an environment -- a Nix profile
# wrapper if one was installed, a `nix develop` subshell otherwise.  It no
# longer builds anything: the dev shell is the environment, and a caller
# outside it is told so rather than wrapped.

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

. "$project_root/scripts/require-nix-shell"

if [ "${1:-}" = "--status" ]; then
  "$project_root/scripts/worktree-port" --explain
  printf 'environment: current Nix dev shell\n'
  printf 'SBCL: %s\nSBCL version: ' "$(command -v sbcl)"
  sbcl --version
  printf 'LUV_SLYNK_DIR: %s\n' "${LUV_SLYNK_DIR:-unset}"
  printf 'LUV_GHOSTTY_LIBRARY: %s\n' "${LUV_GHOSTTY_LIBRARY:-unset}"
  printf 'VK_LAYER_PATH: %s\n' "${VK_LAYER_PATH:-unset}"
  printf 'CL_SOURCE_REGISTRY: %s\n' "${CL_SOURCE_REGISTRY:-unset}"
  printf 'ASDF cache: %s/.cache/common-lisp\n' "$HOME"
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- sbcl
fi

exec "$@"
