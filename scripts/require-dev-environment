# Sourced by Luv launchers that need the checkout's Nix dependencies.
#
# A launcher invoked outside the current development shell re-executes itself
# once through the small nix/ flake.  Re-execution preserves its arguments and
# any variables the launcher deliberately exported before reaching this file.

if [ "${LUV_DEV_ENVIRONMENT_MODE:-}" != nix-develop ]; then
  if ! command -v nix >/dev/null 2>&1; then
    printf 'luv: Nix is required; install it or run this checkout in its dev shell.\n' >&2
    exit 1
  fi
  case "${LUV_DEV_SHELL:-default}" in
    default|slim) ;;
    *) printf 'luv: invalid LUV_DEV_SHELL: %s\n' "$LUV_DEV_SHELL" >&2; exit 2 ;;
  esac
  export LUV_PROJECT_ROOT=$project_root
  exec nix develop --accept-flake-config --no-write-lock-file \
    "path:$project_root/nix#${LUV_DEV_SHELL:-default}" \
    -c "$0" "$@"
fi

case ":${CL_SOURCE_REGISTRY:-}:" in
  *:"$project_root/":*) ;;
  *) export CL_SOURCE_REGISTRY="$project_root/:${CL_SOURCE_REGISTRY:-}" ;;
esac

if [ -z "${LUV_NATIVE_LIBRARY_PATH:-}" ] \
  || [ "${LUV_NATIVE_ENVIRONMENT_ACTIVE:-}" != 1 ]; then
  printf 'luv: the Nix development shell did not activate native libraries.\n' >&2
  exit 1
fi
