#!/bin/sh
# The wiki from a shell: scripts/wiki help.  Builds build/wiki-cli with ASDF
# when the tooling changed, then runs it in the luv development shell.

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

. "$project_root/scripts/require-dev-environment"

exe="$project_root/build/wiki-cli"
stale=$(find "$project_root/wiki" "$project_root/luv-wiki.asd" \
  "$project_root/luv.asd" -newer "$exe" 2>/dev/null || true)
if [ ! -x "$exe" ] || [ -n "$stale" ]; then
  echo "wiki: building $exe" >&2
  # PROGRAM-OP otherwise considers its existing output current even though
  # this wrapper has already found a changed project-system input.
  rm -f "$exe"
  sbcl --script "$project_root/wiki/build.lisp" >/dev/null 2>&1 \
    || sbcl --script "$project_root/wiki/build.lisp"
fi

LUV_ROOT="$project_root" exec "$exe" "$@"
