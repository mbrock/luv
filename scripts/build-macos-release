#!/bin/sh
# Native arm64 build; optional Developer ID signing and notarization.
set -eu
project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$(uname -sm)" != 'Darwin arm64' ]; then
  echo 'This package requires an Apple Silicon Mac running macOS 26 or newer.' >&2
  exit 1
fi
if [ "$(sw_vers -productVersion | cut -d. -f1)" -lt 26 ]; then
  echo 'Metal 4 requires macOS 26 or newer.' >&2
  exit 1
fi
. "$project_root/scripts/require-dev-environment"

output=${1:-"$project_root/build/macos-release"}
# Never replace someone else's app, nor silently reuse a partially built one.
mkdir -p "$output"
output=$(CDPATH='' cd -- "$output" && pwd)
app="$output/Luvcraft.app"
if [ -e "$app" ]; then
  echo "Refusing to overwrite $app; choose an empty output directory." >&2
  exit 1
fi
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources/fonts"
export LUV_RELEASE_RESOURCES="$app/Contents/Resources/"
for font in "$project_root"/fonts/*; do
  # equity is a private git-annex directory, not a game asset.
  [ "$(basename "$font")" = equity ] || cp -R "$font" "$LUV_RELEASE_RESOURCES/fonts/"
done
sbcl --script "$project_root/scripts/build-macos-release.lisp"
python3 "$project_root/scripts/macos-bundle.py" "$app"

tools="$project_root/build/sparkle"
python3 "$project_root/scripts/sparkle-release.py" fetch "$tools"
python3 "$project_root/scripts/sparkle-release.py" prepare "$app" "$tools" \
  --version "${LUV_RELEASE_VERSION:-0.0.1}" \
  --build "${LUV_RELEASE_BUILD:-1}"
/usr/bin/xcrun clang++ -std=c++17 -fobjc-arc -dynamiclib \
  "$project_root/deploy/macos/game-updates.mm" -F"$tools" \
  -framework Cocoa -framework Sparkle -mmacosx-version-min=26.0 \
  -Wl,-rpath,@loader_path -install_name @rpath/libgame-updates.dylib \
  -o "$app/Contents/Frameworks/libgame-updates.dylib"

# Signing happens after every install-name edit and before archiving.
python3 "$project_root/scripts/macos-sign-release.py" "$app"
