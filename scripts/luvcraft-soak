#!/bin/sh
# Soak Luvcraft's LAN multiplayer (#3E8LY0): headless bots replay input tapes
# against a headless host and must agree on the journal and every chunk.
#
#   scripts/luvcraft-soak                       host and guest here, 10 minutes, TCP
#   scripts/luvcraft-soak --minutes 1 --loopback
#   scripts/luvcraft-soak --host [--port 47475] on one machine, and
#   scripts/luvcraft-soak --join HOST[:PORT]    on another
#
# Other options: --seconds N, --seed N, --relief alpine|meadow, --radius N
# (resident chunks around the spawn), --bot-seed N, --tapes DIR (build/soak/).
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$project_root/scripts/require-dev-environment"
cd "$project_root"
exec sbcl --noinform --non-interactive --no-userinit \
  --eval '(require :asdf)' \
  --eval '(handler-bind ((warning (function muffle-warning))) (asdf:load-system "luvcraft/luft/game"))' \
  --eval '(luvcraft.luft.game::soak-main (uiop:command-line-arguments))' \
  --end-toplevel-options "$@"
