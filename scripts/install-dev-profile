#!/bin/sh

# Build the checkout's locked development environment once, then make it a
# durable user-profile GC root.  Normal commands never invoke Nix afterward.

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "${1:-}" in
  '')
    output=dev
    profile_name=luv-dev
    ;;
  --slim)
    output=slim-dev
    profile_name=luv-slim-dev
    ;;
  *)
    printf 'Usage: %s [--slim]\n' "$0" >&2
    exit 2
    ;;
esac

printf 'Building the luv development profile from %s\n' "$project_root"
store_path=$(nix build -L --no-link --print-out-paths \
  "path:$project_root#$output" < /dev/null)

case "$store_path" in
  /nix/store/*-"$profile_name") ;;
  *)
    printf 'Unexpected luv profile output: %s\n' "$store_path" >&2
    exit 1
    ;;
esac

# The exact profile elements are ours.  Build first, so replacement cannot
# strand the shell without a ready store path; Nix profile generations retain
# the previous installation as a rollback point.
nix profile remove dev 2>/dev/null || :
nix profile remove luv-dev 2>/dev/null || :
nix profile remove slim-dev 2>/dev/null || :
nix profile remove luv-slim-dev 2>/dev/null || :
nix profile add "$store_path"

profile_environment="$HOME/.nix-profile/share/luv/env.sh"
if [ ! -r "$profile_environment" ]; then
  printf 'Installed profile has no activation file at %s\n' \
    "$profile_environment" >&2
  exit 1
fi

printf '\nInstalled %s\n' "$store_path"
printf 'Activate now with: . "%s"\n' "$profile_environment"
