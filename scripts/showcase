#!/bin/sh
# Render the reproducible showcase on chapel and publish its annexed media on
# swa.  Host and checkout names are boring environment configuration; capture
# recipes and media identity remain in Lisp and the showcase-media branch.

set -eu

render_host=${LUV_SHOWCASE_RENDER_HOST:-chapel}
render_checkout=${LUV_SHOWCASE_RENDER_CHECKOUT:-luv-showcase}
render_media_checkout=${LUV_SHOWCASE_RENDER_MEDIA_CHECKOUT:-luv-showcase-media}
render_vulkan_icd=${LUV_SHOWCASE_VULKAN_ICD:-/run/opengl-driver/share/vulkan/icd.d/radeon_icd.x86_64.json}
web_host=${LUV_SHOWCASE_WEB_HOST:-swa}
web_checkout=${LUV_SHOWCASE_WEB_CHECKOUT:-/srv/luv}
web_media_checkout=${LUV_SHOWCASE_WEB_MEDIA_CHECKOUT:-/var/www/luv/showcase}
web_service=${LUV_SHOWCASE_WEB_SERVICE:-luvcraft-web.service}
repository=${LUV_SHOWCASE_REPOSITORY:-git@github.com:mbrock/luv}
media_branch=${LUV_SHOWCASE_MEDIA_BRANCH:-showcase-media}

usage() {
  printf '%s\n' \
    'Usage: scripts/showcase bootstrap|render|deploy|publish|status' \
    '' \
    '  bootstrap  create/update the source and annex checkouts on chapel and swa' \
    '  render     fast-forward chapel, render every recipe, annex, commit, and push' \
    '  deploy     fast-forward swa, get annex content from chapel, restart, and check' \
    '  publish    bootstrap, render, then deploy' \
    '  status     show source, media, annex, service, and public HTTP state'
}

valid_host() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

valid_host "$render_host" || { echo "Invalid render host: $render_host" >&2; exit 2; }
valid_host "$web_host" || { echo "Invalid web host: $web_host" >&2; exit 2; }
case "$render_vulkan_icd" in
  /*) ;;
  *) echo "Invalid render Vulkan ICD path: $render_vulkan_icd" >&2; exit 2 ;;
esac
case "$render_vulkan_icd" in
  *[!A-Za-z0-9._/-]*)
    echo "Unsafe render Vulkan ICD path: $render_vulkan_icd" >&2
    exit 2
    ;;
esac

ssh_run() {
  host=$1
  shift
  echo "showcase: connecting to $host"
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" sh -s -- "$@"
}

render_annex_shell() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$render_host" sh -s -- \
    "$render_media_checkout" <<'REMOTE'
set -eu
media_checkout=$1
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
annex_shell=$(git -C "$media_checkout" config --get showcase.annex-shell)
test -x "$annex_shell" || {
  echo "showcase: Chapel annex shell is not executable; run bootstrap" >&2
  exit 1
}
printf '%s\n' "$annex_shell"
REMOTE
}

bootstrap_render() {
  ssh_run "$render_host" "$render_checkout" "$render_media_checkout" \
    "$repository" "$media_branch" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
repository=$3
media_branch=$4
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac

echo "showcase: chapel source $source_checkout"
if [ ! -d "$source_checkout/.git" ]; then
  git clone --progress "$repository" "$source_checkout"
fi
test -z "$(git -C "$source_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty chapel source checkout" >&2
  git -C "$source_checkout" status --short >&2
  exit 1
}
git -C "$source_checkout" fetch --progress origin main
git -C "$source_checkout" switch main
git -C "$source_checkout" merge --ff-only origin/main

echo "showcase: chapel media $media_checkout"
if [ ! -d "$media_checkout/.git" ]; then
  if git ls-remote --exit-code --heads "$repository" "refs/heads/$media_branch" >/dev/null 2>&1; then
    git clone --progress --single-branch --branch "$media_branch" \
      "$repository" "$media_checkout"
  else
    mkdir -p "$media_checkout"
    git -C "$media_checkout" init
    git -C "$media_checkout" remote add origin "$repository"
    git -C "$media_checkout" checkout --orphan "$media_branch"
    printf '%s\n' \
      'media/** annex.largefiles=anything' \
      'media/manifest.sexp annex.largefiles=nothing' \
      >"$media_checkout/.gitattributes"
    git -C "$media_checkout" add .gitattributes
    git -C "$media_checkout" commit -m 'Initialize showcase media branch'
    git -C "$media_checkout" push -u origin "$media_branch"
  fi
fi
echo "showcase: resolving the pinned git-annex"
annex_bin=$(nix develop --verbose -L "$source_checkout#annex" --no-write-lock-file \
  -c sh -c 'dirname "$(command -v git-annex)"')
PATH=$annex_bin:$PATH
export PATH
git -C "$media_checkout" config showcase.annex-shell \
  "$annex_bin/git-annex-shell"
git -C "$media_checkout" annex init "chapel showcase renderer"
echo "showcase: chapel bootstrap complete"
REMOTE
}

bootstrap_web() {
  chapel_annex_shell=$(render_annex_shell)
  ssh_run "$web_host" "$web_checkout" "$web_media_checkout" "$repository" \
    "$media_branch" "$render_host" "$render_media_checkout" \
    "$chapel_annex_shell" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
repository=$3
media_branch=$4
render_host=$5
render_media_checkout=$6
chapel_annex_shell=$7
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
case "$render_media_checkout" in /*) ;; *) render_media_checkout=$HOME/$render_media_checkout ;; esac

echo "showcase: swa source $source_checkout"
test -d "$source_checkout/.git" || git clone --progress "$repository" "$source_checkout"
test -z "$(git -C "$source_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty swa source checkout" >&2
  git -C "$source_checkout" status --short >&2
  exit 1
}
git -C "$source_checkout" fetch --progress origin main
git -C "$source_checkout" switch main
git -C "$source_checkout" merge --ff-only origin/main
if [ "$source_checkout" = /srv/luv ] \
   && [ "$media_checkout" = /var/www/luv/showcase ]; then
  echo "showcase: installing the checked-in web service"
  sudo install -m 0644 "$source_checkout/deploy/luvcraft-web.service" \
    /etc/systemd/system/luvcraft-web.service
  sudo systemctl daemon-reload
else
  echo "showcase: custom swa paths leave service installation to local configuration"
fi

echo "showcase: swa media $media_checkout"
if [ ! -d "$media_checkout/.git" ]; then
  git clone --progress --single-branch --branch "$media_branch" \
    "$repository" "$media_checkout"
fi
echo "showcase: resolving the pinned git-annex"
annex_bin=$(nix develop --verbose -L "$source_checkout#annex" --no-write-lock-file \
  -c sh -c 'dirname "$(command -v git-annex)"')
PATH=$annex_bin:$PATH
export PATH
if git -C "$media_checkout" remote get-url chapel >/dev/null 2>&1; then
  git -C "$media_checkout" remote set-url chapel \
    "$render_host:$render_media_checkout"
else
  git -C "$media_checkout" remote add chapel \
    "$render_host:$render_media_checkout"
fi
git -C "$media_checkout" config remote.chapel.annex-shell \
  "$chapel_annex_shell"
git -C "$media_checkout" config --unset-all remote.chapel.annex-ignore || true
git -C "$media_checkout" annex init "swa showcase web"
ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 \
  "$render_host" true </dev/null
git -C "$media_checkout" annex enableremote chapel
echo "showcase: swa bootstrap complete"
REMOTE
}

render() {
  ssh_run "$render_host" "$render_checkout" "$render_media_checkout" \
    "$media_branch" "$render_vulkan_icd" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
media_branch=$3
vulkan_icd=$4
expected_vulkan_device='AMD Radeon RX 6600 XT'
expected_vulkan_driver=radv
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
test -d "$source_checkout/.git" || { echo "showcase: run bootstrap first" >&2; exit 1; }
test -d "$media_checkout/.git" || { echo "showcase: run bootstrap first" >&2; exit 1; }

echo "showcase: fast-forwarding chapel source"
test -z "$(git -C "$source_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty chapel source checkout" >&2
  git -C "$source_checkout" status --short >&2
  exit 1
}
git -C "$source_checkout" fetch --progress origin main
git -C "$source_checkout" switch main
git -C "$source_checkout" merge --ff-only origin/main

echo "showcase: resolving the pinned git-annex"
annex_bin=$(nix develop --verbose -L "$source_checkout#annex" --no-write-lock-file \
  -c sh -c 'dirname "$(command -v git-annex)"')
PATH=$annex_bin:$PATH
export PATH
git -C "$media_checkout" config showcase.annex-shell \
  "$annex_bin/git-annex-shell"

echo "showcase: fast-forwarding chapel media metadata"
test -z "$(git -C "$media_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty chapel media checkout" >&2
  git -C "$media_checkout" status --short >&2
  exit 1
}
git -C "$media_checkout" fetch --progress origin "$media_branch" git-annex ||
  git -C "$media_checkout" fetch --progress origin "$media_branch"
git -C "$media_checkout" switch "$media_branch"
git -C "$media_checkout" merge --ff-only "origin/$media_branch"

case "$vulkan_icd" in
  /*) ;;
  *) echo "showcase: Vulkan ICD path must be absolute: $vulkan_icd" >&2; exit 1 ;;
esac
test -r "$vulkan_icd" || {
  echo "showcase: configured Vulkan ICD is not readable: $vulkan_icd" >&2
  exit 1
}
echo "showcase: verifying RX 6600 XT RADV rendering through $vulkan_icd"
vulkan_summary=$(
  VK_DRIVER_FILES="$vulkan_icd" \
    nix develop --verbose -L "$source_checkout" --no-write-lock-file -c \
      vulkaninfo --summary
)
printf '%s\n' "$vulkan_summary"
vulkan_device_type=$(printf '%s\n' "$vulkan_summary" | awk '
  /^[[:space:]]*deviceType[[:space:]]*=/ {
    sub(/^[^=]*=[[:space:]]*/, ""); print; exit
  }')
vulkan_device_name=$(printf '%s\n' "$vulkan_summary" | awk '
  /^[[:space:]]*deviceName[[:space:]]*=/ {
    sub(/^[^=]*=[[:space:]]*/, ""); print; exit
  }')
vulkan_driver_name=$(printf '%s\n' "$vulkan_summary" | awk '
  /^[[:space:]]*driverName[[:space:]]*=/ {
    sub(/^[^=]*=[[:space:]]*/, ""); print; exit
  }')
test "$vulkan_device_type" = PHYSICAL_DEVICE_TYPE_DISCRETE_GPU || {
  echo "showcase: refusing non-discrete Vulkan device: ${vulkan_device_type:-unresolved}" >&2
  exit 1
}
case "$vulkan_device_name" in
  *"$expected_vulkan_device"*) ;;
  *)
    echo "showcase: expected Vulkan device containing '$expected_vulkan_device', got '${vulkan_device_name:-unresolved}'" >&2
    exit 1
    ;;
esac
test "$vulkan_driver_name" = "$expected_vulkan_driver" || {
  echo "showcase: expected Vulkan driver '$expected_vulkan_driver', got '${vulkan_driver_name:-unresolved}'" >&2
  exit 1
}
echo "showcase: verified $vulkan_device_name with $vulkan_driver_name"

revision=$(git -C "$source_checkout" rev-parse --short=12 HEAD)
stage_root=$(mktemp -d /tmp/luv-showcase-render.XXXXXX)
rendered_media=$stage_root/rendered-media
previous_media=$stage_root/previous-media
swapped=0
had_previous=0
cleanup_render_stage() {
  status=$?
  trap - EXIT HUP INT TERM
  set +e
  if [ "$swapped" -eq 1 ] && [ "$had_previous" -eq 1 ]; then
    if [ -d "$media_checkout/media" ]; then
      mv "$media_checkout/media" "$stage_root/failed-media"
    fi
    mv "$previous_media" "$media_checkout/media"
  fi
  case "$stage_root" in
    /tmp/luv-showcase-render.*) find "$stage_root" -depth -delete ;;
    *) echo "showcase: refusing unsafe staging cleanup: $stage_root" >&2 ;;
  esac
  exit "$status"
}
trap cleanup_render_stage EXIT HUP INT TERM
mkdir -p "$rendered_media"

echo "showcase: rendering source $revision on chapel into $rendered_media"
VK_DRIVER_FILES="$vulkan_icd" \
  LUV_CAPTURE_OUTPUT_DIRECTORY="$rendered_media" \
  nix develop --verbose -L "$source_checkout" --no-write-lock-file -c \
    make -C "$source_checkout" capture

echo "showcase: replacing the published media tree"
if [ -d "$media_checkout/media" ]; then
  mv "$media_checkout/media" "$previous_media"
  had_previous=1
  swapped=1
fi
mv "$rendered_media" "$media_checkout/media"
swapped=0

echo "showcase: annexing rendered media"
git -C "$media_checkout" annex add media
git -C "$media_checkout" add -A media
if test -n "$(git -C "$media_checkout" status --porcelain)"; then
  git -C "$media_checkout" commit -m "Capture showcase at $revision"
else
  echo "showcase: rendered media is unchanged"
fi
git -C "$media_checkout" push --progress origin "$media_branch" git-annex
echo "showcase: chapel render published"
REMOTE
}

deploy() {
  chapel_annex_shell=$(render_annex_shell)
  ssh_run "$web_host" "$web_checkout" "$web_media_checkout" "$media_branch" \
    "$web_service" "$chapel_annex_shell" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
media_branch=$3
web_service=$4
chapel_annex_shell=$5
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
test -d "$source_checkout/.git" || { echo "showcase: run bootstrap first" >&2; exit 1; }
test -d "$media_checkout/.git" || { echo "showcase: run bootstrap first" >&2; exit 1; }

echo "showcase: fast-forwarding swa source"
test -z "$(git -C "$source_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty swa source checkout" >&2
  git -C "$source_checkout" status --short >&2
  exit 1
}
git -C "$source_checkout" fetch --progress origin main
git -C "$source_checkout" switch main
git -C "$source_checkout" merge --ff-only origin/main

echo "showcase: resolving the pinned git-annex"
annex_bin=$(nix develop --verbose -L "$source_checkout#annex" --no-write-lock-file \
  -c sh -c 'dirname "$(command -v git-annex)"')
PATH=$annex_bin:$PATH
export PATH
git -C "$media_checkout" config remote.chapel.annex-shell \
  "$chapel_annex_shell"
git -C "$media_checkout" config --unset-all remote.chapel.annex-ignore || true
git -C "$media_checkout" annex enableremote chapel

echo "showcase: fast-forwarding swa media metadata"
test -z "$(git -C "$media_checkout" status --porcelain)" || {
  echo "showcase: refusing dirty swa media checkout" >&2
  git -C "$media_checkout" status --short >&2
  exit 1
}
git -C "$media_checkout" fetch --progress origin "$media_branch" git-annex
git -C "$media_checkout" switch "$media_branch"
git -C "$media_checkout" merge --ff-only "origin/$media_branch"
git -C "$media_checkout" fetch --progress chapel git-annex
git -C "$media_checkout" annex get --from chapel media

missing=$(git -C "$media_checkout" annex find --not --in here media)
test -z "$missing" || {
  echo "showcase: annex content still missing:" >&2
  printf '%s\n' "$missing" >&2
  exit 1
}

echo "showcase: warming the web application"
nix develop --verbose -L "$source_checkout" --no-write-lock-file -c \
  "$source_checkout/scripts/luv" help
echo "showcase: restarting $web_service"
sudo systemctl restart "$web_service"
echo "showcase: waiting up to 30 seconds for the listener"
if curl --fail --show-error --verbose --connect-timeout 2 --max-time 2 \
    --retry 30 --retry-all-errors --retry-delay 1 --retry-max-time 30 \
    http://127.0.0.1:8765/healthz; then
  echo "showcase: swa deployment healthy"
  exit 0
fi
sudo systemctl status --no-pager "$web_service" || true
sudo journalctl -u "$web_service" -n 40 --no-pager || true
exit 1
REMOTE
}

status() {
  ssh_run "$render_host" "$render_checkout" "$render_media_checkout" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
echo "chapel source: $source_checkout"
git -C "$source_checkout" status --short --branch
echo "chapel media: $media_checkout"
git -C "$media_checkout" status --short --branch
test -f "$media_checkout/media/manifest.sexp" && sed -n '1,12p' "$media_checkout/media/manifest.sexp"
REMOTE
  ssh_run "$web_host" "$web_checkout" "$web_media_checkout" "$web_service" <<'REMOTE'
set -eu
source_checkout=$1
media_checkout=$2
web_service=$3
case "$source_checkout" in /*) ;; *) source_checkout=$HOME/$source_checkout ;; esac
case "$media_checkout" in /*) ;; *) media_checkout=$HOME/$media_checkout ;; esac
echo "swa source: $source_checkout"
git -C "$source_checkout" status --short --branch
echo "swa media: $media_checkout"
git -C "$media_checkout" status --short --branch
systemctl is-active "$web_service"
curl --fail --silent --show-error https://luv.swa.sh/showcase/ >/dev/null
echo "public showcase: healthy"
REMOTE
}

command=${1:-}
case "$command" in
  bootstrap) bootstrap_render; bootstrap_web ;;
  render) render ;;
  deploy) deploy ;;
  publish) bootstrap_render; bootstrap_web; render; deploy ;;
  status) status ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
