#!/bin/sh

set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
attach_only=

if [ "${1:-}" = "--luvcraft" ]; then
  attach_only=1
  shift
  endpoint="$project_root/build/luvcraft.slynk"
  if [ ! -r "$endpoint" ]; then
    echo "sly: no running luvcraft Slynk endpoint at $endpoint" >&2
    exit 1
  fi
  if ! read -r luvcraft_pid luvcraft_port < "$endpoint"; then
    echo "sly: could not read luvcraft Slynk endpoint at $endpoint" >&2
    exit 1
  fi
  case "$luvcraft_pid:$luvcraft_port" in
    *[!0-9:]*|:*|*:)
      echo "sly: invalid luvcraft Slynk endpoint at $endpoint" >&2
      exit 1
      ;;
  esac
  if ! kill -0 "$luvcraft_pid" 2>/dev/null; then
    rm -f "$endpoint"
    echo "sly: luvcraft pid $luvcraft_pid is no longer running" >&2
    exit 1
  fi
  export LUV_SLYNK_HOST=127.0.0.1
  export LUV_SLYNK_PORT="$luvcraft_port"
  export LUV_SLYNK_PID="$luvcraft_pid"
  export LUV_SLYNK_ATTACH_ONLY=1
fi

if [ -z "$attach_only" ]; then
  unset LUV_SLYNK_HOST LUV_SLYNK_PORT LUV_SLYNK_PID LUV_SLYNK_ATTACH_ONLY
  if [ "${1:-}" = "--lisp" ]; then
    if [ "$#" -lt 2 ]; then
      echo "sly: --lisp requires a session ID or Lisp name" >&2
      exit 2
    fi
    export LUV_LISP_SELECTOR=$2
    shift 2
  fi
fi

. "$project_root/scripts/require-dev-environment"

sly_client="$project_root/build/sly-client"
sly_client_stamp="$project_root/build/sly-client.environment"
resolved_sbcl=$(realpath "$(command -v sbcl)")
sly_client_stale=

if [ ! -x "$sly_client" ] || [ ! -r "$sly_client_stamp" ]; then
  sly_client_stale=1
elif [ "$project_root/sly-client.asd" -nt "$sly_client" ] \
  || [ "$project_root/scripts/sly-client.lisp" -nt "$sly_client" ] \
  || [ "$project_root/parinfer/implementation.lisp" -nt "$sly_client" ]; then
  sly_client_stale=1
elif ! { IFS= read -r built_root && IFS= read -r built_sbcl; } \
  < "$sly_client_stamp" \
  || [ "$built_root" != "$project_root" ] \
  || [ "$built_sbcl" != "$resolved_sbcl" ]; then
  sly_client_stale=1
fi

if [ -n "$sly_client_stale" ]; then
  "$project_root/scripts/build-sly-client"
fi

cd "$project_root"
exec "$sly_client" "$@"
